# 복사해서 .env.local 로 만든 뒤 값을 채우세요: cp .env.example .env.local
# (또는 `npx vercel env pull .env.local` 로 Vercel 등록 값을 한 번에 받기)
# 실제 값은 절대 커밋하지 마세요.

# ── 필수 (이것만 있어도 화면/검색 동작) ─────────────────────────
PUBG_API_KEY=
DATABASE_URL=            # PostgreSQL(Supabase) 연결 문자열
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── 로그인 (없으면 Google/카카오 로그인 불가) ─────────────────────
NEXTAUTH_SECRET=
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ── 관리자 ───────────────────────────────────────────────────────
ADMIN_EMAILS=            # 쉼표로 구분
ADMIN_PASSWORD=
CRON_SECRET=

# ── 캐시/스토리지 (없으면 일부 실시간 데이터 비활성) ──────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 선택 ─────────────────────────────────────────────────────────
GROQ_API_KEY=            # AI 코칭
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_WEBHOOK_URL=
NEXT_PUBLIC_ADS_ENABLED=false
