generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clan {
  id                Int          @id @default(autoincrement())
  name              String       @unique
  leader            String
  description       String?
  announcement      String?
  memberCount       Int
  avgScore          Int?
  mainStyle         String?
  pubgClanId        String?      @unique
  pubgClanTag       String?
  pubgClanLevel     Int?
  pubgMemberCount   Int?
  lastSynced        DateTime?
  region            String?
  isKorean          Boolean?
  shardDistribution String?
  shard             String       @default("steam")
  members           ClanMember[]
}

model ClanMember {
  id             Int               @id @default(autoincrement())
  nickname       String
  score          Int
  style          String
  avgDamage      Float
  avgKills       Float             @default(0)
  avgAssists     Float             @default(0)
  avgSurviveTime Float             @default(0)
  winRate        Float             @default(0)
  top10Rate      Float             @default(0)
  clanId         Int?
  pubgClanId     String?
  pubgPlayerId   String?
  pubgShardId    String?
  lastUpdated    DateTime          @default(now())
  roundsPlayed   Int               @default(0)
  clan           Clan?             @relation(fields: [clanId], references: [id])
  modeStats      PlayerModeStats[]
}

model PlayerMatch {
  id              Int       @id @default(autoincrement())
  pubgAccountId   String
  nickname        String
  shard           String    @default("steam")
  clanMemberId    Int?
  matchId         String
  mode            String
  mapName         String?
  placement       Int
  kills           Int
  assists         Int       @default(0)
  damage          Float
  surviveTime     Float     @default(0)
  createdAt       DateTime
  botKills        Int?
  realKills       Int?
  botDamage       Float?
  realDamage      Float?
  botAssist       Int?
  isBotCorrected  Boolean   @default(false)
  botAnalyzedAt   DateTime?
  teammatesDetail Json?
  telemetryUrl    String?

  @@unique([pubgAccountId, matchId])
}

model PlayerModeStats {
  id              Int        @id @default(autoincrement())
  clanMemberId    Int
  mode            String
  matches         Int
  wins            Int
  top10s          Int
  avgDamage       Float
  avgKills        Float
  avgAssists      Float
  winRate         Float
  top10Rate       Float
  avgSurvivalTime Float      @default(0)
  headshotRate    Float      @default(0)
  longestKill     Float      @default(0)
  clanMember      ClanMember @relation(fields: [clanMemberId], references: [id])
}

model ForumCategory {
  id          String      @id
  name        String
  description String
  icon        String
  color       String
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  posts       ForumPost[]
}

model ForumPost {
  id         Int           @id @default(autoincrement())
  title      String
  content    String
  preview    String?
  author     String
  categoryId String
  views      Int           @default(0)
  likes      Int           @default(0)
  isPinned   Boolean       @default(false)
  isLocked   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  password   String?
  googleId   String?
  likedBy    ForumLike[]
  category   ForumCategory @relation(fields: [categoryId], references: [id])
  replies    ForumReply[]
}

model ForumReply {
  id        Int          @id @default(autoincrement())
  content   String
  author    String
  postId    Int
  parentId  Int?
  likes     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  password  String?
  parent    ForumReply?  @relation("ReplyToReply", fields: [parentId], references: [id])
  children  ForumReply[] @relation("ReplyToReply")
  post      ForumPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model ForumLike {
  id        Int       @id @default(autoincrement())
  postId    Int
  author    String
  createdAt DateTime  @default(now())
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, author])
}

model ForumUser {
  id               Int       @id @default(autoincrement())
  username         String    @unique
  email            String    @unique
  violationCount   Int       @default(0)
  lastViolation    DateTime?
  violationType    String?
  violationContent String?
  isBanned         Boolean   @default(false)
  banReason        String?
  banUntil         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("forum_users")
}

model PubgNews {
  id          Int       @id @default(autoincrement())
  title       String
  link        String    @unique
  url         String?
  category    String?
  publishedAt DateTime?
  publishDate DateTime?
  imageUrl    String?
  summary     String?
  source      String    @default("PUBG_OFFICIAL")
  views       Int       @default(0)
  isActive    Boolean   @default(true)
  priority    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("pubg_news")
}

model WeaponTestResult {
  id              Int      @id @default(autoincrement())
  sessionId       String   @unique
  pubgPlayerId    String?
  nickname        String?
  platform        String?  @default("steam")
  resultType      String
  resultName      String
  similarityScore Float
  surveyVector    Json
  createdAt       DateTime @default(now())

  @@map("weapon_test_results")
}

model RankingUpdateLog {
  id           Int      @id @default(autoincrement())
  updateType   String
  updateTime   DateTime
  status       String
  updatedCount Int      @default(0)
  errorMessage String?
  details      String?
  createdAt    DateTime @default(now())

  @@map("ranking_update_logs")
}

model Notice {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  summary   String?
  type      String
  priority  String    @default("NORMAL")
  isActive  Boolean   @default(true)
  isPinned  Boolean   @default(false)
  showUntil DateTime?
  author    String    @default("관리자")
  views     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("notices")
}

model PlayerCache {
  id                Int       @id @default(autoincrement())
  nickname          String
  pubgShardId       String    @default("steam")
  pubgPlayerId      String?
  score             Int       @default(0)
  style             String    @default("")
  avgDamage         Float     @default(0)
  avgKills          Float     @default(0)
  avgAssists        Float     @default(0)
  avgSurviveTime    Float     @default(0)
  winRate           Float     @default(0)
  top10Rate         Float     @default(0)
  lastUpdated       DateTime  @default(now())
  roundsPlayed      Int?      @default(0)
  ranked_json       String?
  isBanned          Boolean   @default(false)
  bannedAt          DateTime?
  banCheckFailCount Int       @default(0)

  @@unique([nickname, pubgShardId])
  @@map("player_cache")
}

model PlayerAnalysis {
  id               Int      @id @default(autoincrement())
  playerNickname   String
  playerServer     String
  playStyle        String
  playstyleScore   Float
  strengths        String
  weaknesses       String
  killDeathRatio   Float
  damagePerGame    Float
  survivalRate     Float
  aggressionIndex  Float
  consistencyIndex Float
  recommendations  String
  trainingPlan     String
  lastAnalyzed     DateTime @default(now())

  @@unique([playerNickname, playerServer])
  @@map("player_analyses")
}

model CoachingTip {
  id          Int      @id @default(autoincrement())
  category    String
  playStyle   String
  title       String
  description String
  difficulty  String
  priority    Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("coaching_tips")
}

model User {
  id                Int      @id @default(autoincrement())
  steamId           String?  @unique
  pubgNickname      String?
  pubgAccountId     String?
  clanId            Int?
  role              String   @default("user")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  kakaoId           String?  @unique
  platform          String   @default("steam")
  email             String?  @unique @db.VarChar(255)
  nickname          String?  @db.VarChar(100)
  steamNickname     String?  @db.VarChar(100)
  kakaoNickname     String?  @db.VarChar(100)
  consoleNickname   String?  @db.VarChar(100)
  defaultPlatform   String?  @default("steam") @db.VarChar(20)
  dashboardSettings Json?
  googleId          String?  @unique @db.VarChar(255)
  avatarUrl         String?

  @@map("users")
}

model TrainingSession {
  id             Int       @id @default(autoincrement())
  playerNickname String
  playerServer   String
  sessionType    String
  targetSkill    String
  duration       Int
  exercises      String
  goals          String
  status         String    @default("PENDING")
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@map("training_sessions")
}

model PlayerStatSnapshot {
  id             Int      @id @default(autoincrement())
  nickname       String
  pubgShardId    String   @default("steam")
  score          Int      @default(0)
  avgDamage      Float    @default(0)
  avgKills       Float    @default(0)
  avgAssists     Float    @default(0)
  avgSurviveTime Float    @default(0)
  winRate        Float    @default(0)
  top10Rate      Float    @default(0)
  capturedAt     DateTime @default(now())

  @@index([nickname, pubgShardId, capturedAt])
  @@map("player_stat_snapshots")
}

model ClanWar {
  id        Int             @id @default(autoincrement())
  clanA     String
  clanB     String
  scoreA    Int             @default(0)
  scoreB    Int             @default(0)
  map       String          @default("")
  mode      String          @default("squad-fpp")
  note      String          @default("")
  password  String          @default("")
  playedAt  DateTime        @default(now())
  createdAt DateTime        @default(now())
  players   ClanWarPlayer[]

  @@index([clanA, clanB])
  @@map("clan_wars")
}

model ClanWarPlayer {
  id       Int     @id @default(autoincrement())
  warId    Int
  nickname String
  team     String
  kills    Int     @default(0)
  damage   Int     @default(0)
  survived Boolean @default(false)
  war      ClanWar @relation(fields: [warId], references: [id], onDelete: Cascade)

  @@index([warId])
  @@map("clan_war_players")
}

model PlayerReview {
  id            Int      @id @default(autoincrement())
  targetNick    String
  shard         String   @default("steam")
  authorNick    String
  rating        Int
  teamplay      Int      @default(3)
  communication Int      @default(3)
  comment       String   @default("")
  password      String   @default("")
  createdAt     DateTime @default(now())

  @@index([targetNick, shard])
  @@map("player_reviews")
}

model AuthUser {
  id            String        @id @default(cuid())
  googleId      String        @unique
  email         String
  name          String?
  image         String?
  mainAccountId String?
  createdAt     DateTime?     @default(now()) @db.Timestamptz(6)
  pubgAccounts  PubgAccount[]

  @@map("auth_users")
}

model PubgAccount {
  id            String    @id @default(cuid())
  userId        String
  nickname      String
  pubgAccountId String
  platform      String    @default("steam")
  createdAt     DateTime? @default(now()) @db.Timestamptz(6)
  user          AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, pubgAccountId])
  @@map("pubg_accounts")
}

model DonationCounter {
  id        Int      @id @default(1)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("donation_counter")
}

model feedbacks {
  id         Int      @id @default(autoincrement())
  type       String
  message    String
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model ClanLeaderRequest {
  id           Int      @id @default(autoincrement())
  clanId       Int
  clanName     String
  currentLeader String
  requestNickname String
  reason       String
  status       String   @default("pending") // pending | approved | rejected
  createdAt    DateTime @default(now())

  @@map("clan_leader_requests")
}

model Inquiry {
  id        Int      @id @default(autoincrement())
  topic     String
  message   String
  email     String?
  createdAt DateTime @default(now())

  @@map("inquiries")
}

model MapMarker {
  id        Int      @id @default(autoincrement())
  mapId     String   @map("map_id")
  type      String
  x         Float
  y         Float
  label     String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([mapId])
  @@map("map_markers")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model player_weapon_stats {
  id           Int      @id @default(autoincrement())
  playerId     String
  shard        String   @default("steam")
  weaponId     String
  weaponName   String   @default("")
  kills        Int      @default(0)
  damage       Float    @default(0)
  headshots    Int      @default(0)
  savedAt      DateTime @default(now())
  bot_kills    Int      @default(0)
  real_kills   Int      @default(0)
  assists      Int      @default(0)
  shots_fired  Int      @default(0)
  shots_hit    Int      @default(0)
  match_id     String   @default("")
  pickup_count Int      @default(0)

  @@unique([playerId, weaponId, match_id], map: "player_weapon_stats_player_weapon_match_key")
  @@index([weaponId, shard], map: "player_weapon_stats_weaponid_shard_idx")
}

// 검색 제한 / 정지 유저 관리
model RestrictedPlayer {
  id        Int      @id @default(autoincrement())
  nickname  String
  // 'search_restricted' | 'banned'
  type      String   @default("search_restricted")
  reason    String?
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([nickname, type])
  @@map("restricted_players")
}

// 팀 내 피해 통계 (LogPlayerTakeDamage 양방향 집계)
model TeamDamageStat {
  id                Int       @id @default(autoincrement())
  matchId           String
  attackerAccountId String
  victimAccountId   String
  attackerName      String    @default("")
  victimName        String    @default("")
  totalDamage       Float     @default(0)
  hitCount          Int       @default(0)
  groggyCount       Int       @default(0)
  killCount         Int       @default(0)
  weapons           Json      @default("[]")
  firstHitAt        DateTime?
  createdAt         DateTime  @default(now())

  @@unique([matchId, attackerAccountId, victimAccountId])
  @@index([matchId])
  @@map("team_damage_stats")
}
