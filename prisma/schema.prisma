generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clan {
  id                Int          @id @default(autoincrement())
  name              String       @unique
  leader            String
  description       String?
  announcement      String?
  memberCount       Int
  avgScore          Int?
  mainStyle         String?
  pubgClanId        String?      @unique
  pubgClanTag       String?
  pubgClanLevel     Int?
  pubgMemberCount   Int?
  lastSynced        DateTime?
  region            String?
  isKorean          Boolean?
  shardDistribution String?
  shard             String       @default("steam")
  members           ClanMember[]
}

model ClanMember {
  id             Int               @id @default(autoincrement())
  nickname       String
  score          Int
  style          String
  avgDamage      Float
  avgKills       Float             @default(0)
  avgAssists     Float             @default(0)
  avgSurviveTime Float             @default(0)
  winRate        Float             @default(0)
  top10Rate      Float             @default(0)
  clanId         Int?
  pubgClanId     String?
  pubgPlayerId   String?
  pubgShardId    String?
  lastUpdated    DateTime          @default(now())
  roundsPlayed   Int               @default(0)
  clan           Clan?             @relation(fields: [clanId], references: [id])
  modeStats      PlayerModeStats[]
}

model PlayerMatch {
  id              Int       @id @default(autoincrement())
  pubgAccountId   String
  nickname        String
  shard           String    @default("steam")
  clanMemberId    Int?
  matchId         String
  mode            String
  mapName         String?
  placement       Int
  kills           Int
  assists         Int       @default(0)
  damage          Float
  surviveTime     Float     @default(0)
  createdAt       DateTime
  botKills        Int?
  realKills       Int?
  botDamage       Float?
  realDamage      Float?
  botAssist       Int?
  isBotCorrected  Boolean   @default(false)
  botAnalyzedAt   DateTime?
  teammatesDetail Json?
  telemetryUrl    String?

  @@unique([pubgAccountId, matchId])
}

model PlayerModeStats {
  id              Int        @id @default(autoincrement())
  clanMemberId    Int
  mode            String
  matches         Int
  wins            Int
  top10s          Int
  avgDamage       Float
  avgKills        Float
  avgAssists      Float
  winRate         Float
  top10Rate       Float
  avgSurvivalTime Float      @default(0)
  headshotRate    Float      @default(0)
  longestKill     Float      @default(0)
  clanMember      ClanMember @relation(fields: [clanMemberId], references: [id])
}

model ForumCategory {
  id          String      @id
  name        String
  description String
  icon        String
  color       String
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  posts       ForumPost[]
}

model ForumPost {
  id         Int           @id @default(autoincrement())
  title      String
  content    String
  preview    String?
  author     String
  categoryId String
  views      Int           @default(0)
  likes      Int           @default(0)
  isPinned   Boolean       @default(false)
  isLocked   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  password   String?
  googleId   String?
  likedBy    ForumLike[]
  category   ForumCategory @relation(fields: [categoryId], references: [id])
  replies    ForumReply[]
}

model ForumReply {
  id        Int          @id @default(autoincrement())
  content   String
  author    String
  postId    Int
  parentId  Int?
  likes     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  password  String?
  parent    ForumReply?  @relation("ReplyToReply", fields: [parentId], references: [id])
  children  ForumReply[] @relation("ReplyToReply")
  post      ForumPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model ForumLike {
  id        Int       @id @default(autoincrement())
  postId    Int
  author    String
  createdAt DateTime  @default(now())
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, author])
}

model ForumUser {
  id               Int       @id @default(autoincrement())
  username         String    @unique
  email            String    @unique
  violationCount   Int       @default(0)
  lastViolation    DateTime?
  violationType    String?
  violationContent String?
  isBanned         Boolean   @default(false)
  banReason        String?
  banUntil         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("forum_users")
}

model PubgNews {
  id          Int       @id @default(autoincrement())
  title       String
  link        String    @unique
  url         String?
  category    String?
  publishedAt DateTime?
  publishDate DateTime?
  imageUrl    String?
  summary     String?
  source      String    @default("PUBG_OFFICIAL")
  views       Int       @default(0)
  isActive    Boolean   @default(true)
  priority    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("pubg_news")
}

model WeaponTestResult {
  id              Int      @id @default(autoincrement())
  sessionId       String   @unique
  pubgPlayerId    String?
  nickname        String?
  platform        String?  @default("steam")
  resultType      String
  resultName      String
  similarityScore Float
  surveyVector    Json
  createdAt       DateTime @default(now())

  @@map("weapon_test_results")
}

model RankingUpdateLog {
  id           Int      @id @default(autoincrement())
  updateType   String
  updateTime   DateTime
  status       String
  updatedCount Int      @default(0)
  errorMessage String?
  details      String?
  createdAt    DateTime @default(now())

  @@map("ranking_update_logs")
}

model Notice {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  summary   String?
  type      String
  priority  String    @default("NORMAL")
  isActive  Boolean   @default(true)
  isPinned  Boolean   @default(false)
  showUntil DateTime?
  author    String    @default("관리자")
  views     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("notices")
}

model PlayerCache {
  id                Int       @id @default(autoincrement())
  nickname          String
  pubgShardId       String    @default("steam")
  pubgPlayerId      String?
  score             Int       @default(0)
  style             String    @default("")
  avgDamage         Float     @default(0)
  avgKills          Float     @default(0)
  avgAssists        Float     @default(0)
  avgSurviveTime    Float     @default(0)
  winRate           Float     @default(0)
  top10Rate         Float     @default(0)
  lastUpdated       DateTime  @default(now())
  roundsPlayed      Int?      @default(0)
  ranked_json       String?
  isBanned          Boolean   @default(false)
  bannedAt          DateTime?
  banCheckFailCount Int       @default(0)
  isSearchHidden    Boolean   @default(false)
  searchHiddenAt    DateTime?

  @@unique([nickname, pubgShardId])
  @@index([pubgPlayerId, avgDamage, isBanned, lastUpdated(sort: Desc)], name: "idx_player_cache_recent")
  @@map("player_cache")
}

model PlayerAnalysis {
  id               Int      @id @default(autoincrement())
  playerNickname   String
  playerServer     String
  playStyle        String
  playstyleScore   Float
  strengths        String
  weaknesses       String
  killDeathRatio   Float
  damagePerGame    Float
  survivalRate     Float
  aggressionIndex  Float
  consistencyIndex Float
  recommendations  String
  trainingPlan     String
  lastAnalyzed     DateTime @default(now())

  @@unique([playerNickname, playerServer])
  @@map("player_analyses")
}

model CoachingTip {
  id          Int      @id @default(autoincrement())
  category    String
  playStyle   String
  title       String
  description String
  difficulty  String
  priority    Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("coaching_tips")
}

model User {
  id                Int      @id @default(autoincrement())
  steamId           String?  @unique
  pubgNickname      String?
  pubgAccountId     String?
  clanId            Int?
  role              String   @default("user")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  kakaoId           String?  @unique
  platform          String   @default("steam")
  email             String?  @unique @db.VarChar(255)
  nickname          String?  @db.VarChar(100)
  steamNickname     String?  @db.VarChar(100)
  kakaoNickname     String?  @db.VarChar(100)
  consoleNickname   String?  @db.VarChar(100)
  defaultPlatform   String?  @default("steam") @db.VarChar(20)
  dashboardSettings Json?
  googleId          String?  @unique @db.VarChar(255)
  avatarUrl         String?

  @@map("users")
}

model TrainingSession {
  id             Int       @id @default(autoincrement())
  playerNickname String
  playerServer   String
  sessionType    String
  targetSkill    String
  duration       Int
  exercises      String
  goals          String
  status         String    @default("PENDING")
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@map("training_sessions")
}

model PlayerStatSnapshot {
  id             Int      @id @default(autoincrement())
  nickname       String
  pubgShardId    String   @default("steam")
  score          Int      @default(0)
  avgDamage      Float    @default(0)
  avgKills       Float    @default(0)
  avgAssists     Float    @default(0)
  avgSurviveTime Float    @default(0)
  winRate        Float    @default(0)
  top10Rate      Float    @default(0)
  capturedAt     DateTime @default(now())

  @@index([nickname, pubgShardId, capturedAt])
  @@map("player_stat_snapshots")
}

model ClanWar {
  id        Int             @id @default(autoincrement())
  clanA     String
  clanB     String
  scoreA    Int             @default(0)
  scoreB    Int             @default(0)
  map       String          @default("")
  mode      String          @default("squad-fpp")
  note      String          @default("")
  password  String          @default("")
  playedAt  DateTime        @default(now())
  createdAt DateTime        @default(now())
  players   ClanWarPlayer[]

  @@index([clanA, clanB])
  @@map("clan_wars")
}

model ClanWarPlayer {
  id       Int     @id @default(autoincrement())
  warId    Int
  nickname String
  team     String
  kills    Int     @default(0)
  damage   Int     @default(0)
  survived Boolean @default(false)
  war      ClanWar @relation(fields: [warId], references: [id], onDelete: Cascade)

  @@index([warId])
  @@map("clan_war_players")
}

model PlayerReview {
  id            Int      @id @default(autoincrement())
  targetNick    String
  shard         String   @default("steam")
  authorNick    String
  rating        Int
  teamplay      Int      @default(3)
  communication Int      @default(3)
  comment       String   @default("")
  password      String   @default("")
  createdAt     DateTime @default(now())

  @@index([targetNick, shard])
  @@map("player_reviews")
}

model AuthUser {
  id            String        @id @default(cuid())
  googleId      String        @unique
  email         String
  name          String?
  image         String?
  mainAccountId String?
  createdAt     DateTime?     @default(now()) @db.Timestamptz(6)
  pubgAccounts  PubgAccount[]

  @@map("auth_users")
}

model PubgAccount {
  id            String    @id @default(cuid())
  userId        String
  nickname      String
  pubgAccountId String
  platform      String    @default("steam")
  createdAt     DateTime? @default(now()) @db.Timestamptz(6)
  user          AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, pubgAccountId])
  @@map("pubg_accounts")
}

model DonationCounter {
  id        Int      @id @default(1)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("donation_counter")
}

model feedbacks {
  id         Int      @id @default(autoincrement())
  type       String
  message    String
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model ClanLeaderRequest {
  id              Int      @id @default(autoincrement())
  clanId          Int
  clanName        String
  currentLeader   String
  requestNickname String
  reason          String
  status          String   @default("pending") // pending | approved | rejected
  createdAt       DateTime @default(now())

  @@map("clan_leader_requests")
}

model Inquiry {
  id        Int       @id @default(autoincrement())
  topic     String
  message   String
  email     String?
  userId    String? // 로그인 유저면 AuthUser.id 연결 (마이페이지 "내 문의"용)
  createdAt DateTime  @default(now())
  reply     String?
  repliedAt DateTime?
  status    String    @default("pending") // "pending" | "replied"

  @@map("inquiries")
}

model MapMarker {
  id        Int      @id @default(autoincrement())
  mapId     String   @map("map_id")
  type      String
  x         Float
  y         Float
  label     String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([mapId])
  @@map("map_markers")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model player_weapon_stats {
  id           Int      @id @default(autoincrement())
  playerId     String
  shard        String   @default("steam")
  weaponId     String
  weaponName   String   @default("")
  kills        Int      @default(0)
  damage       Float    @default(0)
  headshots    Int      @default(0)
  savedAt      DateTime @default(now())
  bot_kills    Int      @default(0)
  real_kills   Int      @default(0)
  assists      Int      @default(0)
  shots_fired  Int      @default(0)
  shots_hit    Int      @default(0)
  match_id     String   @default("")
  pickup_count Int      @default(0)

  @@unique([playerId, weaponId, match_id], map: "player_weapon_stats_player_weapon_match_key")
  @@index([weaponId, shard], map: "player_weapon_stats_weaponid_shard_idx")
}

// 검색 제한 / 정지 유저 관리
model RestrictedPlayer {
  id        Int      @id @default(autoincrement())
  nickname  String
  // 'search_restricted' | 'banned'
  type      String   @default("search_restricted")
  reason    String?
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([nickname, type])
  @@map("restricted_players")
}

// 팀 내 피해 통계 (LogPlayerTakeDamage 양방향 집계)
model TeamDamageStat {
  id                Int       @id @default(autoincrement())
  matchId           String
  attackerAccountId String
  victimAccountId   String
  attackerName      String    @default("")
  victimName        String    @default("")
  totalDamage       Float     @default(0)
  hitCount          Int       @default(0)
  groggyCount       Int       @default(0)
  killCount         Int       @default(0)
  weapons           Json      @default("[]")
  firstHitAt        DateTime?
  createdAt         DateTime  @default(now())

  @@unique([matchId, attackerAccountId, victimAccountId])
  @@index([matchId])
  @@map("team_damage_stats")
}

// 배그 치지직 스트리머 목록
model StreamerList {
  id             Int       @id @default(autoincrement())
  nickname       String // 배그 인게임 닉네임 (PKGG 전적 링크용)
  shard          String    @default("steam") // steam | kakao
  chzzkChannelId String    @unique
  streamerName   String // 치지직 표시명
  profileImage   String? // 치지직 프로필 이미지 URL
  isLive         Boolean   @default(false)
  viewerCount    Int       @default(0)
  streamTitle    String? // 현재 방송 제목
  lastCheckedAt  DateTime?
  createdAt      DateTime  @default(now())

  @@map("streamer_list")
}

// 플레이어 낙하지점 히트맵
model PlayerLandingStat {
  id        Int      @id @default(autoincrement())
  accountId String
  mapName   String
  locationX Float
  locationY Float
  matchId   String
  createdAt DateTime @default(now())

  @@index([accountId, mapName])
  @@index([matchId])
  @@map("player_landing_stats")
}

// ── 클랜 내전 (ClanBattle) ──────────────────────────────────────────────────
model ClanBattle {
  id          Int       @id @default(autoincrement())
  title       String
  createdBy   String // userId
  status      String    @default("active") // active, ended
  startDate   DateTime  @default(now())
  endDate     DateTime?
  memo        String?
  createdAt   DateTime  @default(now())
  confirmedAt DateTime? // 참가자 확정 시각 (null이면 미확정)

  type        String    @default("battle") // "battle" | "killmatch"
  startTime   DateTime? // 킬내기 시작 시간
  endTime     DateTime? // 킬내기 종료 시간 (선택)
  targetScore Int? // 목표 점수 (선택, 먼저 달성하면 종료)

  rule    ClanBattleRule?
  teams   ClanBattleTeam[]
  squads  ClanBattleSquad[]
  players ClanBattlePlayer[]
  matches ClanBattleMatch[]

  @@index([createdBy])
  @@map("clan_battles")
}

model ClanBattleRule {
  id       Int        @id @default(autoincrement())
  battleId Int        @unique
  battle   ClanBattle @relation(fields: [battleId], references: [id])

  // 등수별 점수 예: {"1":10,"2":6,"3":3,"4":2,"5":1}
  placePoints Json @default("{}")

  // 킬 기본 점수
  killBasePoint Float @default(1.0)

  // 티어별 킬 배율 예: {"1":1.0,"2":1.5,"3":2.0,"4":2.5,"5":3.0}
  tierMultipliers Json @default("{}")

  // 티어 배율 사용 여부 (false면 모든 티어를 1.0으로 취급)
  useTierMultiplier Boolean @default(true)

  // 등수 점수 부여 방식: "individual"(스쿼드원 각자에게 부여) | "squad"(스쿼드 합산에만 추가, 개인 점수엔 미반영)
  placementPointMode String @default("individual")

  @@map("clan_battle_rules")
}

model ClanBattleTeam {
  id       Int                @id @default(autoincrement())
  battleId Int
  battle   ClanBattle         @relation(fields: [battleId], references: [id])
  teamName String
  clanName String?
  players  ClanBattlePlayer[]
  squads   ClanBattleSquad[]

  @@index([battleId])
  @@map("clan_battle_teams")
}

model ClanBattleSquad {
  id        Int                @id @default(autoincrement())
  battleId  Int
  battle    ClanBattle         @relation(fields: [battleId], references: [id])
  teamId    Int?
  team      ClanBattleTeam?    @relation(fields: [teamId], references: [id])
  squadName String // "스쿼드1", "Alpha" 등
  players   ClanBattlePlayer[]

  @@index([battleId])
  @@index([teamId])
  @@map("clan_battle_squads")
}

model ClanBattlePlayer {
  id       Int                     @id @default(autoincrement())
  battleId Int
  battle   ClanBattle              @relation(fields: [battleId], references: [id])
  teamId   Int?
  team     ClanBattleTeam?         @relation(fields: [teamId], references: [id])
  squadId  Int?
  squad    ClanBattleSquad?        @relation(fields: [squadId], references: [id])
  nickname String
  tier     Int                     @default(3) // 1~5
  userId   String? // nullable, PKGG 계정 연동 시
  results  ClanBattleMatchResult[]

  // 과거 외부 기록 (다른 내전/커스텀에서의 실적 등, 수동 입력)
  prevGames        Int? // 이전 경기 수
  prevAvgKills     Float? // 이전 평균 킬
  prevAvgDamage    Float? // 이전 평균 딜량
  prevAvgPlacement Float? // 이전 평균 순위
  prevAvgAssists   Float? // 이전 평균 어시스트
  prevMemo         String? // 메모 (어디서 진행했는지 등)

  @@index([battleId])
  @@index([teamId])
  @@index([squadId])
  @@map("clan_battle_players")
}

model ClanBattleMatch {
  id          Int                     @id @default(autoincrement())
  battleId    Int
  battle      ClanBattle              @relation(fields: [battleId], references: [id])
  matchNumber Int
  playedAt    DateTime                @default(now())
  mapName     String?
  memo        String?
  pubgMatchId String? // 원본 PUBG matchId (킬내기 봇킬 재분석 시 텔레메트리 재조회용)
  results     ClanBattleMatchResult[]

  @@index([battleId])
  @@map("clan_battle_matches")
}

model ClanBattleMatchResult {
  id             Int              @id @default(autoincrement())
  matchId        Int
  match          ClanBattleMatch  @relation(fields: [matchId], references: [id])
  playerId       Int
  player         ClanBattlePlayer @relation(fields: [playerId], references: [id])
  placement      Int // 등수
  squadPlacement Int? // 스쿼드 등수 (개인 등수와 별개)
  kills          Int              @default(0)
  damage         Int              @default(0) // 경기별 딜량
  assists        Int              @default(0) // 경기별 어시스트
  score          Float            @default(0) // 자동 계산된 점수

  botAnalysisStatus String @default("pending") // "pending" | "analyzing" | "completed" | "failed"
  rawKills          Int    @default(0) // 원본 킬 (봇킬 포함)
  realKills         Int? // 실킬 (분석 완료 시)

  @@index([matchId])
  @@index([playerId])
  @@map("clan_battle_match_results")
}

// ── 시즌 아카이브 (지난 시즌 PlayerMatch 원본 삭제 전 요약 통계 보존) ──────────
model MapStatSeason {
  id          Int      @id @default(autoincrement())
  season      Int // 41, 42...
  mapName     String // "Taego", "Erangel"...
  shard       String   @default("all") // "all", "steam", "kakao"
  playCount   Int
  percentage  Float
  avgSurvival Float?
  avgKills    Float?
  createdAt   DateTime @default(now())

  @@unique([season, mapName, shard])
}

model WeaponMetaSeason {
  id         Int      @id @default(autoincrement())
  season     Int
  shard      String   @default("all")
  weaponId   String
  weaponName String
  kills      Int
  killRate   Float
  avgDamage  Float?
  rank       Int
  createdAt  DateTime @default(now())

  @@unique([season, weaponId, shard])
}

model PlayerSeasonSummary {
  id            Int      @id @default(autoincrement())
  season        Int
  nickname      String
  shard         String
  totalGames    Int
  avgRealKills  Float?
  avgRealDamage Float?
  avgKills      Float
  avgDamage     Float
  winRate       Float
  top10Rate     Float
  botKillRatio  Float?
  topMap1       String?
  topMap2       String?
  topMap3       String?
  topWeapon1    String?
  topWeapon2    String?
  topWeapon3    String?
  createdAt     DateTime @default(now())

  @@unique([season, nickname, shard])
}

model TeamDamageStatSeason {
  id               Int      @id @default(autoincrement())
  season           Int
  shard            String   @default("all")
  attackerNickname String
  totalDamage      Int
  totalKills       Int
  totalGroggies    Int
  victimCount      Int
  createdAt        DateTime @default(now())

  @@unique([season, attackerNickname, shard])
}
